<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Addis Ababa Parks - Unity Park Live Map</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #f0f4f1;
      color: #2c3e50;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    header {
      text-align: center;
      margin-bottom: 20px;
    }

    header h1 {
      color: #1b5e20;
      font-size: 2rem;
    }

    header p {
      color: #555;
      font-size: 0.95rem;
      margin-top: 5px;
    }

    /* Map Viewport Container */
    .map-container {
      position: relative;
      width: 100%;
      max-width: 850px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      background-color: #d4e1d4;
    }

    /* Embedded SVG Graphic Map */
    .map-frame {
      position: relative;
      width: 100%;
      padding-top: 66.66%; /* 3:2 Aspect Ratio */
    }

    .map-svg-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    /* Park Feature Pins */
    .pin {
      position: absolute;
      width: 30px;
      height: 30px;
      background-color: #2e7d32;
      color: #fff;
      font-weight: bold;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg) translate(-50%, -50%);
      transform-origin: bottom left;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      transition: transform 0.2s ease, background-color 0.2s ease;
      z-index: 5;
    }

    .pin span {
      transform: rotate(45deg);
      font-size: 13px;
    }

    .pin:hover {
      background-color: #114b14;
      transform: rotate(-45deg) scale(1.2) translate(-50%, -50%);
    }

    /* Live User Location Blue Pulse Marker */
    .user-location-pin {
      position: absolute;
      width: 18px;
      height: 18px;
      background-color: #1e88e5;
      border: 3px solid #ffffff;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 0 4px rgba(30, 136, 229, 0.35);
      z-index: 10;
      transition: left 0.5s ease, top 0.5s ease;
    }

    .user-location-pin::after {
      content: '';
      position: absolute;
      top: -6px; left: -6px; right: -6px; bottom: -6px;
      border-radius: 50%;
      border: 2px solid #1e88e5;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(2.2); opacity: 0; }
    }

    /* Info Popup Modal */
    .info-card {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: 90%;
      max-width: 420px;
      background: white;
      padding: 16px 20px;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.25);
      display: none;
      z-index: 20;
    }

    .info-card.active {
      display: block;
      animation: slideUp 0.3s ease-out;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translate(-50%, 20px); }
      to { opacity: 1; transform: translate(-50%, 0); }
    }

    .info-card h3 {
      color: #1b5e20;
      font-size: 1.2rem;
      margin-bottom: 6px;
    }

    .info-card p {
      font-size: 0.9rem;
      color: #555;
      line-height: 1.4;
    }

    .close-btn {
      position: absolute;
      top: 10px;
      right: 14px;
      border: none;
      background: none;
      font-size: 20px;
      cursor: pointer;
      color: #888;
    }

    .close-btn:hover {
      color: #000;
    }

    /* Status Bar */
    .status-bar {
      margin-top: 15px;
      padding: 10px 20px;
      background-color: #e8f5e9;
      color: #2e7d32;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <header>
    <h1>Unity Park (እንጦጦ / ዮኒቲ ፓርክ)</h1>
    <p>Interactive Map & Real-Time GPS Tracking</p>
  </header>

  <div class="map-container">
    <div class="map-frame" id="mapFrame">
      
      <!-- Built-in Graphic Map Background -->
      <svg class="map-svg-bg" viewBox="0 0 600 400" preserveAspectRatio="none">
        <rect width="600" height="400" fill="#c8e6c9"/>
        <!-- Pathways -->
        <path d="M 50 200 Q 200 100 400 220 T 550 350" stroke="#a5d6a7" stroke-width="25" fill="none"/>
        <path d="M 150 50 Q 250 250 450 150" stroke="#a5d6a7" stroke-width="18" fill="none"/>
        <!-- Green Garden Areas -->
        <circle cx="200" cy="140" r="70" fill="#81c784" opacity="0.6"/>
        <circle cx="420" cy="280" r="80" fill="#81c784" opacity="0.6"/>
        <circle cx="480" cy="110" r="50" fill="#81c784" opacity="0.6"/>
      </svg>

      <!-- Live GPS Marker -->
      <div class="user-location-pin" id="userPin" style="display: none;" title="Your Live Location"></div>

      <!-- Unity Park Landmarks -->
      <div class="pin" style="top: 35%; left: 33%;" onclick="showInfo('Grand Palace & Throne Hall', 'Restored historic palace hall featuring royal artifacts and Ethiopian national history.')">
        <span>1</span>
      </div>

      <div class="pin" style="top: 70%; left: 70%;" onclick="showInfo('Unity Park Zoo', 'Home to black-maned lions, gelada baboons, and diverse regional wildlife exhibits.')">
        <span>2</span>
      </div>

      <div class="pin" style="top: 27%; left: 80%;" onclick="showInfo('Regional States Pavilion', 'Interactive pavilion showcasing indigenous culture, architecture, and art from all regions of Ethiopia.')">
        <span>3</span>
      </div>

      <!-- Info Modal Card -->
      <div class="info-card" id="infoCard">
        <button class="close-btn" onclick="closeInfo()">&times;</button>
        <h3 id="cardTitle">Landmark Title</h3>
        <p id="cardDescription">Details will appear here.</p>
      </div>

    </div>
  </div>

  <div class="status-bar" id="statusBar">
    📡 Requesting GPS access...
  </div>

  <script>
    function showInfo(title, description) {
      document.getElementById('cardTitle').innerText = title;
      document.getElementById('cardDescription').innerText = description;
      document.getElementById('infoCard').classList.add('active');
    }

    function closeInfo() {
      document.getElementById('infoCard').classList.remove('active');
    }

    // Actual GPS Boundary coordinates calibrated for Unity Park, Addis Ababa
    const PARK_BOUNDS = {
      north: 9.027000, 
      south: 9.020000, 
      west:  38.758000, 
      east:  38.766000  
    };

    const userPin = document.getElementById('userPin');
    const statusBar = document.getElementById('statusBar');

    function updatePosition(position) {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;

      statusBar.innerHTML = `📍 GPS Active: ${lat.toFixed(5)}, ${lng.toFixed(5)}`;

      if (lat <= PARK_BOUNDS.north && lat >= PARK_BOUNDS.south &&
          lng >= PARK_BOUNDS.west && lng <= PARK_BOUNDS.east) {

        const xPercent = ((lng - PARK_BOUNDS.west) / (PARK_BOUNDS.east - PARK_BOUNDS.west)) * 100;
        const yPercent = ((PARK_BOUNDS.north - lat) / (PARK_BOUNDS.north - PARK_BOUNDS.south)) * 100;

        userPin.style.left = `${xPercent}%`;
        userPin.style.top = `${yPercent}%`;
        userPin.style.display = 'block';
      } else {
        statusBar.innerHTML = `📍 GPS Active (${lat.toFixed(4)}, ${lng.toFixed(4)} — Outside Unity Park bounds)`;
        userPin.style.display = 'none';
      }
    }

    function handleError(error) {
      statusBar.innerHTML = "⚠️ Allow browser location permissions to show your live marker.";
    }

    if ('geolocation' in navigator) {
      navigator.geolocation.watchPosition(updatePosition, handleError, {
        enableHighAccuracy: true,
        maximumAge: 2000,
        timeout: 10000
      });
    } else {
      statusBar.innerHTML = "❌ Geolocation is not supported by this browser.";
    }
  </script>
</body>
</html>
